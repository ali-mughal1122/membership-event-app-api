# ==============================================================================
# PRODUCTION CONFIGURATION (.env.prod)
# Usage: Place in /opt/taxiterminalen/prod/.env on the Contabo VPS
# ==============================================================================
PORT=3500
NODE_ENV=production

# High entropy secret (generate on VPS via: openssl rand -base64 64)
JWT_SECRET=REPLACE_WITH_STRONG_PRODUCTION_SECRET

# Internal Docker Database (Never expose 5432 externally)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=taxiterminalen_prod_user
DB_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_DB_PASSWORD
DB_DATABASE=taxiterminalen_prod

# Strictly set to false to prevent schema wipes in production
DB_SYNCHRONIZE=false

# Allowed CORS Origins (Live domains only)
ALLOWED_ORIGINS=https://taxiterminalen.dk,https://www.taxiterminalen.dk

# Production SMTP Mailer (e.g. Simply.com Mail)
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_USER=noreply@taxiterminalen.dk
SMTP_PASSWORD=REPLACE_WITH_PRODUCTION_SMTP_PASSWORD

FRONTEND_URL=https://taxiterminalen.dk
