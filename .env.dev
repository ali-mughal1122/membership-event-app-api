# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (.env.dev)
# Usage: Copy to .env for local development
# ==============================================================================
PORT=3500
NODE_ENV=development

# JWT Secret for local dev
JWT_SECRET=dev_super_secret_jwt_key_987654321

# Local PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mem_event_db
DB_SYNCHRONIZE=true

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# Sandbox Mailer (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password

FRONTEND_URL=http://localhost:4200
