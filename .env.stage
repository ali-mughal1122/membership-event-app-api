# ==============================================================================
# STAGING CONFIGURATION (.env.stage)
# Usage: Place in /opt/taxiterminalen/stage/.env on the Contabo VPS
# ==============================================================================
PORT=3500
NODE_ENV=staging

# Random generated secret (replace with: openssl rand -base64 48)
JWT_SECRET=GENERATE_RANDOM_STAGE_JWT_SECRET_STRING_48_CHARS

# Internal Docker Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=taxiterminalen_stage
DB_PASSWORD=GENERATE_STRONG_STAGE_DB_PASSWORD
DB_DATABASE=taxiterminalen_stage
DB_SYNCHRONIZE=true

# Allowed CORS Origins (Contabo IP and optional stage subdomain)
ALLOWED_ORIGINS=http://YOUR_CONTABO_IP,http://stage.taxiterminalen.dk

# Sandbox Mailer (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_stage_mailtrap_user
SMTP_PASSWORD=your_stage_mailtrap_password

FRONTEND_URL=http://YOUR_CONTABO_IP
